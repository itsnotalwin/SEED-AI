/**
 * SEED Observatory — Evolution View
 * Interactive architecture family tree with filtering and detail views.
 */
export async function renderEvolution(container, data) {
  if (!container) return;

  const models = data.models || [];
  const experiments = data.experiments || [];

  container.innerHTML = `
    <div class="panel">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <span class="crumb">OBSERVATORY <span class="slash">/</span> EVOLUTION</span>
      </nav>

      <header class="section-header">
        <span class="kicker">ARCHITECTURE FAMILY TREE</span>
        <h2>From SEED-0 to Proposed Families</h2>
      </header>

      <p class="lede">Only actual trained and persisted models appear as solid nodes. Unbuilt concepts are dashed and explicitly labelled <code>PROPOSED</code>. Click a node for details.</p>

      <div class="evolution-controls" style="margin-bottom: var(--space-4); display: flex; gap: var(--space-3); flex-wrap: wrap;">
        <button class="btn outline" data-filter="all">All</button>
        <button class="btn outline active" data-filter="implemented">Implemented</button>
        <button class="btn outline" data-filter="planned">Planned</button>
        <button class="btn outline" data-filter="research">Research</button>
      </div>

      <div class="evolution-tree" id="evolution-tree" role="tree" aria-label="Architecture evolution tree">
        <!-- Populated by JS -->
      </div>

      <div class="model-detail-panel hidden" id="model-detail-panel" aria-live="polite">
        <!-- Populated when node clicked -->
      </div>
    </div>
  `;

  // Initialize tree
  initEvolutionTree(data);
}

function initEvolutionTree(data) {
  const treeContainer = document.getElementById('evolution-tree');
  const detailPanel = document.getElementById('model-detail-panel');
  const filterButtons = document.querySelectorAll('.evolution-controls .btn');
  const models = data.models || [];
  let currentFilter = 'implemented';

  const archOrder = [
    { id: 'seed-0', name: 'SEED-0', family: 'feedforward', parent: null },
    { id: 'seed-ffn', name: 'SEED-FFN', family: 'feedforward', parent: 'seed-0' },
    { id: 'seed-rnn', name: 'SEED-RNN', family: 'recurrent', parent: null },
    { id: 'seed-gru', name: 'SEED-GRU', family: 'recurrent', parent: 'seed-rnn' },
    { id: 'seed-lstm', name: 'SEED-LSTM', family: 'recurrent', parent: 'seed-rnn' },
    { id: 'seed-transformer', name: 'SEED-TRANSFORMER', family: 'attention', parent: null },
    { id: 'seed-rwkv', name: 'SEED-RWKV', family: 'hybrid-recurrence', parent: null },
    { id: 'seed-ssm', name: 'SEED-SSM', family: 'state-space', parent: null },
    { id: 'seed-liquid', name: 'SEED-LIQUID', family: 'continuous-time', parent: null },
    { id: 'seed-memory', name: 'SEED-MEMORY', family: 'memory-augmented', parent: null },
    { id: 'seed-sprout', name: 'SEED-SPROUT', family: 'adaptive', parent: null },
  ];

  function renderTree(filter) {
    const filtered = archOrder.filter(a => {
      if (filter === 'all') return true;
      const model = models.find(m => m.id === a.id);
      return model?.status === filter || (!model && filter === 'proposed');
    });

    const html = filtered.map(arch => {
      const model = models.find(m => m.id === arch.id);
      const isProposed = !model || model.status !== 'implemented';
      const status = model?.status || 'proposed';
      const params = model?.parameters ? model.parameters.toLocaleString() : '—';
      const ctx = model?.context_chars ? `${model.context_chars} chars` : '—';
      const bestBpc = model?.best_validation_bpc ? model.best_validation_bpc.toFixed(2) : '—';

      return `
        <div class="evo-node ${isProposed ? 'proposed' : ''}" 
             data-arch="${arch.id}" 
             role="treeitem" 
             tabindex="0"
             aria-expanded="false">
          <div class="evo-node-main">
            <span class="evo-toggle" aria-hidden="true">▸</span>
            <span class="evo-name">${arch.name}</span>
            <span class="evo-status ${isProposed ? 'proposed' : ''}">${status.toUpperCase()}</span>
          </div>
          <div class="evo-meta" style="display:none;">
            <div class="meta-row"><span class="meta-label">Parameters:</span> <span class="meta-value">${params}</span></div>
            <div class="meta-row"><span class="meta-label">Context:</span> <span class="meta-value">${ctx}</span></div>
            <div class="meta-row"><span class="meta-label">Best Val BPC:</span> <span class="meta-value">${bestBpc}</span></div>
          </div>
        </div>
      `;
    }).join('');

    document.querySelector('#evolution-tree').innerHTML = html;

    // Add click handlers
    document.querySelectorAll('.evo-node').forEach(node => {
      node.addEventListener('click', (e) => {
        if (e.target.closest('.evo-toggle')) return;
        const archId = node.dataset.arch;
        showModelDetail(archId);
        node.classList.toggle('expanded');
        node.querySelector('.evo-meta').style.display = node.classList.contains('expanded') ? 'block' : 'none';
        node.querySelector('.evo-toggle').textContent = node.classList.contains('expanded') ? '▾' : '▸';
      });

      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          node.click();
        }
      });
    });
  }

  function showModelDetail(archId) {
    const model = models.find(m => m.id === archId);
    const archInfo = archOrder.find(a => a.id === archId);

    if (!model && archId !== 'seed-0') {
      detailPanel.innerHTML = `
        <div class="detail-header">
          <h3>${archInfo?.name || archId.toUpperCase()}</h3>
          <button class="btn outline" id="close-detail">Close</button>
        </div>
        <div class="proposed-notice">
          <h4>PROPOSED ARCHITECTURE</h4>
          <p>This architecture has not been implemented or trained yet.</p>
          <p>Status: <strong>${archInfo?.family || 'unknown'}</strong> family</p>
        </div>
      `;
    } else {
      const params = model?.parameters ? model.parameters.toLocaleString() : '—';
      const ctx = model?.context_chars ? `${model.context_chars} chars` : '—';
      const bestBpc = model?.best_validation_bpc ? model.best_validation_bpc.toFixed(2) : '—';
      const status = model?.status || 'proposed';

      detailPanel.innerHTML = `
        <div class="detail-header">
          <h3>${model?.id?.toUpperCase() || archInfo?.name}</h3>
          <button class="btn outline" id="close-detail">Close</button>
        </div>
        <div class="detail-grid">
          <div class="detail-section">
            <h4>Architecture</h4>
            <dl>
              <dt>Family</dt><dd>${archInfo?.family || 'unknown'}</dt>
              <dt>Status</dt><dd><span class="status-badge ${status === 'implemented' ? '' : 'proposed'}">${status.toUpperCase()}</span></dd>
              <dt>Parameters</dt><dd>${params}</dd>
              <dt>Context Length</dt><dd>${ctx}</dd>
              <dt>Best Validation BPC</dt><dd>${bestBpc}</dd>
            </dl>
          </div>
          <div class="detail-section">
            <h4>Experiments</h4>
            ${renderModelExperiments(model)}
          </div>
          <div class="detail-section">
            <h4>Checkpoints</h4>
            <p class="empty-state">No checkpoints published yet.</p>
          </div>
        </div>
      `;
    }

    detailPanel.classList.remove('hidden');
    detailPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

    document.getElementById('close-detail')?.addEventListener('click', () => {
      detailPanel.classList.add('hidden');
    });
  }

  function renderModelExperiments(model) {
    const experiments = (data.experiments || []).filter(e => e.architecture_id === (model?.id));
    if (experiments.length === 0) {
      return '<p class="empty-state">No experiments published for this model.</p>';
    }
    return experiments.map(exp => `
      <div class="exp-summary">
        <span class="exp-id">${exp.experiment_id?.slice(0, 8)}</span>
        <span class="exp-bpc">${exp.validation?.bitsPerCharacter?.toFixed(2) || '—'} BPC</span>
        <span class="exp-status">${exp.status || 'completed'}</span>
      </div>
    `).join('');
  }

  // Filter handlers
  document.querySelectorAll('.evolution-controls .btn').forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      renderTree(currentFilter);
    });
  });

  // Initial render
  let currentFilter = 'implemented';
  renderTree(currentFilter);
}